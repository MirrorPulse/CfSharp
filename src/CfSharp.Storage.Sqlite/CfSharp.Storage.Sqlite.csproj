<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>true</IsPackable>
    <PackageId>CfSharp.Storage.Sqlite</PackageId>
    <Description>Official SQLite durable-state provider for CfSharp.</Description>
    <PackageTags>windows;cloud-files;cfapi;sqlite;persistence</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CfSharp\CfSharp.csproj" />
  </ItemGroup>
</Project>
