{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CfSharp generated documentation manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "sourceCommit",
    "generatedAtUtc",
    "generator",
    "configuration",
    "files",
    "contentRoot"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "CfSharp" },
    "sourceCommit": { "type": "string", "minLength": 7 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "DocFX" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "configuration": { "type": "string", "const": "Release" },
    "sourceVersion": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+-preview\\.[0-9]+$" },
    "contentRoot": { "type": "string", "const": "cfsharp" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/].*" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
